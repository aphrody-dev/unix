# CachyOS sm_89 Ada Lovelace / Raptor Lake Baremetal & WSL2 Kernel Config Fragment
# Target: Linux v7.4-rc2
# CPU: Intel Core i7-13700F (16C/24T: 8P + 8E, AVX2, FMA3, BMI2)
# GPU: NVIDIA GeForce RTX 4070 (sm_89, Ada Lovelace, DirectStorage, dxgkrnl GPU-PV)

# Rust Kernel Support
CONFIG_RUST=y
CONFIG_RUST_IS_AVAILABLE=y

# Scheduler: Sched-Ext & BORE (Burst-Oriented Response Enhancer)
CONFIG_SCHED_CLASS_EXT=y
CONFIG_SCHED_BORE=y
CONFIG_HZ_1000=y
CONFIG_HZ=1000
CONFIG_PREEMPT_BUILD=y
CONFIG_PREEMPT=y
CONFIG_PREEMPT_FULL=y

# Processor Architecture & Intel Raptor Lake Optimizations
CONFIG_64BIT=y
CONFIG_X86_64=y
CONFIG_MNATIVE_INTEL=y
CONFIG_X86_INTEL_PSTATE=y
CONFIG_INTEL_HFI_THERMAL=y
CONFIG_INTEL_TURBO_MAX_3=y
CONFIG_SCHED_MC_PRIO=y
CONFIG_SCHED_SMT=y
CONFIG_CPU_FREQ_GOV_PERFORMANCE=y
CONFIG_CPU_FREQ_DEFAULT_GOV_PERFORMANCE=y

# Memory Management: MGLRU & Transparent Huge Pages
CONFIG_LRU_GEN=y
CONFIG_LRU_GEN_ENABLED=y
CONFIG_LRU_GEN_STATS=y
CONFIG_TRANSPARENT_HUGEPAGE=y
CONFIG_TRANSPARENT_HUGEPAGE_ALWAYS=y
CONFIG_ZSTD_COMPRESS=y
CONFIG_ZSTD_DECOMPRESS=y
CONFIG_ZRAM=y
CONFIG_ZRAM_DEF_COMP_ZSTD=y

# Gaming & Windows NT Compatibility Primitives (Proton / Wine)
CONFIG_NTSYNC=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
CONFIG_GENERIC_ENTRY=y
CONFIG_HAVE_ARCH_SECCOMP_FILTER=y

# Graphics & DirectX 12 / GPU-PV Bridge
CONFIG_DRM=y
CONFIG_DRM_KMS_HELPER=y
CONFIG_DXGKRNL=y
CONFIG_HYPERV=y
CONFIG_HYPERVISOR_GUEST=y
CONFIG_PCI_HYPERV=y
CONFIG_DRM_NOUVEAU=m

# Networking & Low-Latency IPC
CONFIG_TCP_CONG_BBR=y
CONFIG_DEFAULT_BBR=y
CONFIG_NET_SCH_FQ=y
CONFIG_DEFAULT_NET_SCH="fq"
# --- Aphrody Omarchy + WSL2 Native Zero-Overhead Extensions (Linux 7.4) ---
CONFIG_HYPERV_VSOCKETS=y
CONFIG_VSOCKETS=y
CONFIG_VIRTIO=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_FS=y
CONFIG_FUSE_FS=y
CONFIG_FUSE_PASSTHROUGH=y
CONFIG_PLAN9CAPS=y
CONFIG_NET_9P=y
CONFIG_NET_9P_VIRTIO=y
CONFIG_UDMABUF=y
CONFIG_DMABUF_HEAPS=y
CONFIG_DMABUF_HEAPS_SYSTEM=y
CONFIG_SYNC_FILE=y
CONFIG_BPF_SYSCALL=y
CONFIG_BPF_JIT=y
